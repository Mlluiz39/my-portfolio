# ==========================================
# Configurações do Resend (E-mail)
# ==========================================
# Chave de API do Resend - Obtenha em: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# E-mail remetente (use onboarding@resend.dev em testes ou seu domínio verificado em produção)
RESEND_FROM_EMAIL=onboarding@resend.dev

# E-mail de destino que receberá as mensagens e solicitações de contato
RESEND_TO_EMAIL=contato@mlluizdevtech.com.br

# ==========================================
# Configurações do Site
# ==========================================
# URL pública do site / aplicação
SITE_URL=https://mlluizdevtech.com.br
VITE_SITE_URL=https://mlluizdevtech.com.br
